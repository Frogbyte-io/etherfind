{
  "name": "@etherfind/core",
  "version": "0.1.0",
  "description": "Network discovery engine for locating directly-connected Ethernet devices. UI-independent.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/test-support/**", "!dist/**/*.tsbuildinfo"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbyte-io/etherfind.git",
    "directory": "packages/core"
  },
  "private": true
}
